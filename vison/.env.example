# --- TMDB (https://www.themoviedb.org/settings/api) — usata per i film ---
# Basta UNA delle due chiavi (se sono presenti entrambe, viene usata quella
# v4 "Read Access Token"). Registrati su TMDB, crea un'app e copia:
#  - VITE_TMDB_API_KEY: la "API Key (v3 auth)"
#  - VITE_TMDB_ACCESS_TOKEN: il "API Read Access Token (v4 auth)"
VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=

# --- Firebase (usata SOLO per la sezione News) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
